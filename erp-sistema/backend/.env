# ============================================================
# MODELO DE VARIÁVEIS DE AMBIENTE — copiar para .env e editar
# NUNCA commitar o arquivo .env com valores reais
# Gerar JWT_SECRET com: openssl rand -base64 64
# ============================================================

# Backend
PORT=3002
NODE_ENV=development

JWT_SECRET=uma_chave_super_secreta_e_longa_com_mais_de_32_caracteres_123!
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000

# Registro de usuários: false = apenas admins podem registrar via POST /users
# true  = útil APENAS para semear o primeiro admin em ambiente de desenvolvimento
ALLOW_PUBLIC_REGISTRATION=false

# Base de dados — SQLite (padrão dev)
DB_PATH=erp.db
# Desativar em produção (usar migrações)
DB_SYNCHRONIZE=false

# Base de dados — PostgreSQL (docker-compose / produção)
 DB_TYPE=postgres
 DB_HOST=localhost
 DB_PORT=5432
 DB_USER=erp_user
 DB_PASSWORD=erp_pass
 DB_NAME=erp_db

# PostgreSQL para Docker Compose
 POSTGRES_DB=erp_db
 POSTGRES_USER=erp_user
 POSTGRES_PASSWORD=erp_pass
